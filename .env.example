# 複製此檔為 .env，填入實際值（本機開發用）
# Railway 正式環境請直接在 Railway 控制台設定環境變數

# PostgreSQL 連線字串（Railway 會自動提供）
DATABASE_URL=postgresql://user:password@localhost:5432/phbay_travel

# 管理後台查詢用密鑰（自訂一組強密碼）
# 查詢諮詢紀錄：GET /api/contacts?key=你的密鑰
ADMIN_KEY=your_secret_admin_key_here

# Flask 開發模式（正式環境設為 0）
FLASK_DEBUG=0

# 抽獎工具 Meta 留言匯入（Meta App + 粉專 Page Access Token）
META_GRAPH_API_VERSION=v25.0
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
META_FB_PAGE_ID=your_facebook_page_id
META_IG_USER_ID=your_instagram_professional_account_id

# P0 每日健康檢查（GitHub Actions 建議放 Secrets／Variables）
# GOOGLE_SERVICE_ACCOUNT_JSON 可由 GA4 與 GSC 共用；也可只設既有 GSC_SERVICE_ACCOUNT_JSON
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GA4_PROPERTY_ID=123456789
GSC_SITE_URL=sc-domain:phbay.info
GSC_SITEMAP_URL=https://www.phbay.info/sitemap.xml
GSC_INDEXED_BASELINE=50
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_OWNER_USER_ID=your_line_owner_user_id

# 澎湖百旅：每完成一趟可認列旅次給多少點（未設時 100）
MEMBER_POINTS_PER_TRIP=100
MEMBER_PRIVACY_POLICY_VERSION=v1

# 會員 V1 社群登入（callback 必須同平台後台設定完全一致）
LINE_OAUTH_CLIENT_ID=
LINE_OAUTH_CLIENT_SECRET=
LINE_OAUTH_REDIRECT_URI=https://www.phbay.info/api/member/oauth/line/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.phbay.info/api/member/oauth/google/callback

# 供應商中立的手機 OTP webhook：POST {to,code,ttl_seconds}
# 未設定時 API 會回 503，不會在 log 暴露驗證碼。
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=

# 澎湖百旅：可覆寫等級門檻與會員編號前綴（未設時使用 1/2/5/10/20/100）
MEMBER_NO_PREFIX=PH
MEMBER_LEVELS_JSON=[{"trips":1,"name":"初見澎湖"},{"trips":2,"name":"澎湖熟旅人"},{"trips":5,"name":"澎湖知己"},{"trips":10,"name":"澎湖旅家"},{"trips":20,"name":"澎湖守護者"},{"trips":100,"name":"百澎傳奇"}]
